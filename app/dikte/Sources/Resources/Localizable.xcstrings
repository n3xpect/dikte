{
  "sourceLanguage": "tr",
  "strings": {
    "%@ / %@ kayıt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@ entries"
          }
        }
      }
    },
    "%@ açıldı ama yazı alanı hazır değildi — metin panoda (⌘V)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opened, but no text field was ready — text is on the clipboard (⌘V)"
          }
        }
      }
    },
    "%@ boş · en az %@ boş kalmalı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ free · at least %@ must stay free"
